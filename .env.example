# Copy this to .env for local development (never commit .env to git)

# Planning Center API credentials (from pco_config.json)
PCO_CLIENT_ID=your_planning_center_app_id
PCO_SECRET=your_planning_center_secret

# Team PIN for app access (share this with your care team)
APP_PIN=choose_a_pin

# Random string — generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=generate_a_random_string_here

# Note category name in PCO (must match exactly)
CARE_CATEGORY_NAME=Care Team Actions
